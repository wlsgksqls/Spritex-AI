{
  "name": "spritex-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:worker": "wrangler dev --config worker/wrangler.jsonc --port 8787",
    "build": "next build",
    "deploy:pages": "next build && wrangler pages deploy out --project-name=spritex-ai",
    "deploy:worker": "wrangler deploy --config worker/wrangler.jsonc",
    "lint": "eslint",
    "test": "tsx --test lib/sheet.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "gifenc": "^1.0.3",
    "next": "16.3.3",
    "pngjs": "^7.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "wrangler": "^4.127.1"
  }
}
